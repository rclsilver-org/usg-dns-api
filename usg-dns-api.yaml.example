# HTTP server settings
- key: HTTP_LISTEN_HOST
  value: 127.0.0.1

- key: HTTP_LISTEN_PORT
  value: 8080

# Unifi
- key: UNIFI_URL
  value: https://unifi-controller.example.com

- key: UNIFI_SITE
  value: default

# Authentication: either an API key (UniFi OS), or a username/password pair.
# When UNIFI_API_KEY is set, the username and the password are ignored.
- key: UNIFI_API_KEY
  value: your-api-key

# - key: UNIFI_USERNAME
#   value: usg-dns-api
#
# - key: UNIFI_PASSWORD
#   value: s3cr3t

# # Skip the TLS certificate verification (self-signed controller certificate)
# - key: UNIFI_INSECURE
#   value: "true"

# # Hosts
# - key: HOSTS_FILE
#   value: /config/user-data/hosts

# # DB
# - key: DB_PATH
#   value: /config/user-data/usg-dns-api.db
